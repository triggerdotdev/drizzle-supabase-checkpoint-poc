# Local deploy configuration. Use your own Trigger.dev project.
TRIGGER_PROJECT_REF=proj_replace_me
TRIGGER_API_URL=https://api.trigger.dev
# A deployed environment key; local dev cannot demonstrate a checkpoint.
TRIGGER_SECRET_KEY=

# Upload these four variables to the same deployed Trigger.dev environment.
# Supavisor shared transaction endpoint, port 6543.
DATABASE_URL=
# Optional provider CA PEM. TLS verification remains enabled.
DATABASE_CA_PEM=
ANTHROPIC_API_KEY=
POC_MODEL=claude-haiku-4-5-20251001

# Local observer only: session pooler (5432) or direct connection to the same database.
DATABASE_OBSERVER_URL=

# Optional local-only evidence. The main experiment works without these.
# Management API token, needed only by `pnpm logs`.
SUPABASE_ACCESS_TOKEN=
# Metrics require a project service_role credential; omit both to skip metrics.
SUPABASE_METRICS_URL=
SUPABASE_METRICS_KEY=
